# Application
# Optional. Application name displayed by framework integrations. Default: aibot.
APP_NAME=aibot
# Optional. Runtime environment. Allowed values: dev, test, prod. Default: dev.
APP_ENV=dev
# Optional. Application log level. Default: INFO.
LOG_LEVEL=INFO
# Optional. Collection interval in minutes; must be at least 1. Default: 30.
PARSE_INTERVAL=30
# Optional. Maximum news items per source; allowed range: 1..100. Default: 10.
MAX_NEWS_PER_SOURCE=10

# PostgreSQL
# Required. Application database URL; only the postgresql+asyncpg scheme is supported.
DATABASE_URL=postgresql+asyncpg://aibot:change-me@postgres:5432/aibot
# Docker Compose infrastructure settings. Use non-demo credentials outside local development.
POSTGRES_DB=aibot
POSTGRES_USER=aibot
POSTGRES_PASSWORD=change-me

# Redis
# Optional on CP1. Redis URL reserved for later background-processing stages.
# REDIS_URL=redis://redis:6379/0

# RabbitMQ
# Optional on CP1. RabbitMQ URL reserved for the later Celery stage.
# RABBITMQ_URL=amqp://aibot:change-me@rabbitmq:5672/
# Docker Compose infrastructure settings for the future RabbitMQ service.
RABBITMQ_USER=aibot
RABBITMQ_PASSWORD=change-me

# OpenAI
# Optional globally; required only when a generation endpoint is called.
# OPENAI_API_KEY=sk-example-not-a-real-key
# Optional. Model name used by the OpenAI Responses API. Default: gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini
# Optional. Maximum output tokens; allowed range: 50..4000. Default: 300.
# OPENAI_MAX_TOKENS=300

# Telegram
# Optional globally; required for Telegram ingestion or publication. Issued by Telegram.
# TELEGRAM_API_ID=123456
# Optional globally; required for Telegram ingestion or publication. Keep it secret.
# TELEGRAM_API_HASH=example-not-a-real-hash
# Optional. Prepared and authorized Telethon session name. Default: aibot.
# TELEGRAM_SESSION_NAME=aibot
# Optional globally; required only by the manual Post publication endpoint.
# TELEGRAM_TARGET_CHANNEL=@example_channel
