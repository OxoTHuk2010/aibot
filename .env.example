# Приложение
# Необязательно для локального процесса. Compose использует default aibot.
APP_NAME=aibot
# Необязательно. Окружение: dev, test или prod. По умолчанию: dev.
APP_ENV=dev
# Необязательно. Уровень логирования. По умолчанию: INFO.
LOG_LEVEL=INFO
# Необязательно для локального процесса. Минимум 1; Compose не передаёт значение.
# Текущее расписание Beat зафиксировано как каждые 30 минут и не читает параметр.
PARSE_INTERVAL=30
# Необязательно для локального процесса: 1..100. Compose использует default 10.
MAX_NEWS_PER_SOURCE=10
# Необязательно. Автоматически публиковать созданные pipeline Post. По умолчанию: false.
# Значение true разрешает реальную внешнюю отправку через выбранный Telegram publisher.
AUTO_PUBLISH=false
# Необязательно. Максимум Post за один pipeline run: 1..10. По умолчанию: 2.
PIPELINE_MAX_POSTS_PER_RUN=2
# Необязательно. Максимум NewsItem в одном Post: 1..10. По умолчанию: 5.
PIPELINE_NEWS_PER_POST=5

# PostgreSQL
# Обязательно для локального приложения и тестов. Допустима только схема
# postgresql+asyncpg. В Compose URL строится из POSTGRES_* и hostname postgres.
DATABASE_URL=postgresql+asyncpg://aibot:change-me@postgres:5432/aibot
# Инфраструктурные параметры Docker Compose. Замените демонстрационный пароль.
POSTGRES_DB=aibot
POSTGRES_USER=aibot
POSTGRES_PASSWORD=change-me

# Redis
# Необязательно для локального процесса. Compose не передаёт URL и запускает Redis
# как подготовленную инфраструктуру, но app, Celery и pipeline его не используют.
# REDIS_URL=redis://redis:6379/0

# RabbitMQ / Celery
# Необязательно для FastAPI, обязательно для локальных worker/Beat. RabbitMQ —
# единственный broker; // выбирает vhost по умолчанию. Экранируйте спецсимволы URL.
RABBITMQ_URL=amqp://aibot:change-me@rabbitmq:5672//
# Инфраструктурные параметры Compose; из них строится контейнерный RABBITMQ_URL.
RABBITMQ_USER=aibot
RABBITMQ_PASSWORD=change-me

# AI-провайдер
# Необязательно при старте. Допустимо openai или ollama; default: openai.
# Пример выбирает проверенный локальный demonstration backend Ollama.
AI_PROVIDER=ollama

# OpenAI
# Необязательно глобально; требуется при AI_PROVIDER=openai и вызове генерации.
# OPENAI_API_KEY=sk-example-not-a-real-key
# Необязательно. Модель OpenAI Responses API. По умолчанию: gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini
# Необязательно. Максимум output tokens: 50..4000. По умолчанию: 300.
# OPENAI_MAX_TOKENS=300

# Ollama
# Требуется при AI_PROVIDER=ollama. Compose-first пример использует проверенный
# Docker Desktop alias хоста. Для локального Python-процесса задайте localhost:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Необязательно. Установленный локальный model tag. По умолчанию: gemma4:e4b.
OLLAMA_MODEL=gemma4:e4b
# Необязательно. HTTP timeout в секундах: >0..600. По умолчанию: 120.
OLLAMA_TIMEOUT=120

# Публикация в Telegram
# Необязательно при старте. Допустимо telethon или bot; default: telethon.
# Пример выбирает проверенный demonstration backend Telegram Bot API.
TELEGRAM_PUBLISHER=bot

# Telegram ingestion / Telethon publication
# Необязательно глобально. API credentials и заранее авторизованная session нужны
# для Telegram parser; те же credentials нужны при TELEGRAM_PUBLISHER=telethon.
# TELEGRAM_API_ID=123456
# Секрет. Не сохраняйте реальное значение в Git.
# TELEGRAM_API_HASH=example-not-a-real-hash
# Необязательно. Имя заранее авторизованной Telethon session. По умолчанию: aibot.
# TELEGRAM_SESSION_NAME=aibot
# Требуется только для publication через Telethon, но не для Telegram parser.
# TELEGRAM_TARGET_CHANNEL=@example_channel

# Telegram Bot API publication
# Требуется только при TELEGRAM_PUBLISHER=bot. Не сохраняйте реальный token в Git.
# TELEGRAM_BOT_TOKEN=replace-with-a-test-bot-token
# Целевой чат или приватный канал. Поддерживаются числовые ID вида -1001234567890.
# TELEGRAM_TARGET_CHAT_ID=-1001234567890
