# Application
# Optional. Application name displayed by framework integrations. Default: aibot.
APP_NAME=aibot
# Optional. Runtime environment. Allowed values: dev, test, prod. Default: dev.
APP_ENV=dev
# Optional. Application log level. Default: INFO.
LOG_LEVEL=INFO
# Optional. Collection interval in minutes; must be at least 1. Default: 30.
PARSE_INTERVAL=30
# Optional. Maximum news items per source; allowed range: 1..100. Default: 10.
MAX_NEWS_PER_SOURCE=10
# Optional. Publish pipeline-generated posts automatically. Default: false. Enabling this sends
# real messages through the configured Telegram publisher.
AUTO_PUBLISH=false
# Optional. Maximum generated posts per pipeline run; allowed range: 1..10. Default: 2.
PIPELINE_MAX_POSTS_PER_RUN=2
# Optional. News items grouped into one Post; allowed range: 1..10. Default: 5.
PIPELINE_NEWS_PER_POST=5

# PostgreSQL
# Required. Application database URL; only the postgresql+asyncpg scheme is supported.
DATABASE_URL=postgresql+asyncpg://aibot:change-me@postgres:5432/aibot
# Docker Compose infrastructure settings. Use non-demo credentials outside local development.
POSTGRES_DB=aibot
POSTGRES_USER=aibot
POSTGRES_PASSWORD=change-me

# Redis
# Optional on CP1. Redis URL reserved for later background-processing stages.
# REDIS_URL=redis://redis:6379/0

# RabbitMQ / Celery
# Optional for FastAPI, but required by Celery worker and Beat. RabbitMQ is the only broker;
# the trailing // selects the default vhost. Percent-encode reserved characters in credentials.
RABBITMQ_URL=amqp://aibot:change-me@rabbitmq:5672//
# Docker Compose infrastructure settings used to start RabbitMQ and construct RABBITMQ_URL.
RABBITMQ_USER=aibot
RABBITMQ_PASSWORD=change-me

# AI provider
# Optional. Allowed values: openai, ollama. Default: openai (the original CP4 backend).
# The example selects the locally demonstrable Ollama path.
AI_PROVIDER=ollama

# OpenAI
# Optional globally; required only when AI_PROVIDER=openai and generation is requested.
# OPENAI_API_KEY=sk-example-not-a-real-key
# Optional. Model name used by the OpenAI Responses API. Default: gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini
# Optional. Maximum output tokens; allowed range: 50..4000. Default: 300.
# OPENAI_MAX_TOKENS=300

# Ollama
# Optional unless AI_PROVIDER=ollama. For a host process use http://localhost:11434;
# Docker Compose defaults to the Docker Desktop host alias instead.
OLLAMA_BASE_URL=http://localhost:11434
# Optional. Installed Ollama model used for generation. Default: gemma4:e4b.
OLLAMA_MODEL=gemma4:e4b
# Optional. HTTP timeout in seconds; allowed range: >0..600. Default: 120.
OLLAMA_TIMEOUT=120

# Telegram publisher
# Optional. Allowed values: telethon, bot. Default: telethon (the original CP4 backend).
# The example selects the Bot API demonstration path.
TELEGRAM_PUBLISHER=bot

# Telethon
# Optional globally; required for Telegram ingestion or TELEGRAM_PUBLISHER=telethon.
# TELEGRAM_API_ID=123456
# Optional globally; required for Telegram ingestion or Telethon publication. Keep it secret.
# TELEGRAM_API_HASH=example-not-a-real-hash
# Optional. Prepared and authorized Telethon session name. Default: aibot.
# TELEGRAM_SESSION_NAME=aibot
# Optional globally; required only by the manual Post publication endpoint.
# TELEGRAM_TARGET_CHANNEL=@example_channel

# Telegram Bot API
# Optional globally; required only when TELEGRAM_PUBLISHER=bot. Keep it secret.
# TELEGRAM_BOT_TOKEN=replace-with-a-test-bot-token
# Optional globally; required only when TELEGRAM_PUBLISHER=bot. Private channel IDs such as
# -1001234567890 are supported.
# TELEGRAM_TARGET_CHAT_ID=-1001234567890
